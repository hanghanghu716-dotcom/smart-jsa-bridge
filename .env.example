# No override preserves the existing production connection.
# For a separate test project, copy this file to .env.local and set BOTH values.
# Values must be literal (do not use ${VARIABLE} interpolation).
# VITE_SUPABASE_URL=https://your-test-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_test_project_key
# Never put a secret key, service-role key, DB password or Vercel token in VITE_*.

# Optional server-only operator catalog for a manual affiliate pilot.
# Keep account tracking links out of public Git; never prefix with VITE_.
JSA_COMMERCE_CATALOG_JSON=
