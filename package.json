{
  "name": "smart-jsa-bridge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
"scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.js",
    "build": "vite build",
    "snap": "react-snap",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.95.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@toast-ui/react-editor": "^3.2.3",
    "github-markdown-css": "^5.9.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.10.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.6.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "npm:rolldown-vite@7.2.5",
    "puppeteer": "^19.11.1",
    "react-snap": "^1.23.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "reactSnap": {
    "puppeteerExecutable": "/usr/bin/google-chrome",
    "source": "dist",
    "include": [
      "/ko/",
      "/en-US/",
      "/en-GB/",
      "/en-AU/",
      "/de-DE/",
      "/fr-FR/",
      "/es-ES/",
      "/ru-RU/"
    ],
    "exclude": [
      "/explore",
      "/login",
      "/profile",
      "/library",
      "/analysis",
      "/procedure",
      "/export",
      "/admin",
      "/layout",
      "/reset-password"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-web-security",
      "--allow-file-access-from-files"
    ],
    "concurrency": 4,
    "cacheAjaxRequests": true,
    "puppeteerIgnoreHTTPSErrors": true
  }
}
