{
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/about",
      "destination": "/en-US/about",
      "permanent": true
    },
    {
      "source": "/:lng/ppe",
      "destination": "/:lng/protectiveequipment",
      "permanent": true
    },
    {
      "source": "/:lng/guide/common",
      "destination": "/:lng/guideline/common",
      "permanent": true
    },
    {
      "source": "/:lng/guide/manu",
      "destination": "/:lng/guideline/manufacturing",
      "permanent": true
    },
    {
      "source": "/:lng/guide/chem",
      "destination": "/:lng/guideline/chemical",
      "permanent": true
    },
    {
      "source": "/:lng/guide/const",
      "destination": "/:lng/guideline/construction",
      "permanent": true
    },
    {
      "source": "/:lng/guide/general",
      "destination": "/:lng/guideline/general",
      "permanent": true
    },
    {
      "source": "/:lng/guide/highrisk",
      "destination": "/:lng/guideline/high-risk",
      "permanent": true
    },
    {
      "source": "/:lng(en-US|en-AU|ar-SA|en-GB|ja-JP|ru-RU|it-IT|es-ES|de-DE|fr-FR|pt-BR|en-CA)/case-study/jsa-form-work",
      "destination": "/:lng/case-study/%20jsa-form-work",
      "permanent": true
    },
    {
      "source": "/de-DE/case-study/jsa-leak-testing",
      "destination": "/de-DE/case-study/%20jsa-leak-testing",
      "permanent": true
    },
    {
      "source": "/:lng(ja-JP|it-IT)/case-study/jsa-%20roof-truss",
      "destination": "/:lng/case-study/jsa-roof-truss",
      "permanent": true
    }
  ],
  "functions": {
    "api/public-jsa.js": {
      "includeFiles": "dist/public-jsa-shell.html"
    },
    "api/explore.js": {
      "includeFiles": "dist/public-jsa-shell.html"
    },
    "api/case-study.js": {
      "includeFiles": "dist/public-jsa-shell.html"
    },
    "api/content-index.js": {
      "includeFiles": ".cache/content-shells/**"
    }
  },
  "rewrites": [
    {
      "source": "/:lng(zh-CN|zh-TW)/:path*",
      "destination": "/api/retired-locale"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/content-feed?kind=index"
    },
    {
      "source": "/sitemap-:kind(static|cases|public).xml",
      "destination": "/api/content-feed?kind=:kind"
    },
    {
      "source": "/:lng/feed.xml",
      "destination": "/api/content-feed?kind=rss&lng=:lng"
    },
    {
      "source": "/:lng/case-study/:slug",
      "destination": "/api/case-study?lng=:lng&slug=:slug"
    },
    {
      "source": "/:lng/archive",
      "destination": "/api/content-index?lng=:lng&kind=archive"
    },
    {
      "source": "/:lng(en-US|en-AU|ar-SA|en-GB|ja-JP|ru-RU|it-IT|es-ES|de-DE|fr-FR|pt-BR|en-CA|en-CA-AB|en-CA-ON|en-CA-BC|fr-CA-QC|en-SG|ko)",
      "destination": "/api/content-index?lng=:lng&kind=home"
    },
    {
      "source": "/:lng/explore",
      "destination": "/api/explore?lng=:lng"
    },
    {
      "source": "/:lng/public-jsa/:id",
      "destination": "/api/public-jsa?lng=:lng&id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
